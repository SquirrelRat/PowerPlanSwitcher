<Window x:Class="PowerPlanSwitcher.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Power Plan Switcher"
        Icon="pack://application:,,,/PowerPlanSwitcher;component/Assets/app.png"
        Height="620" Width="540"
        MinHeight="480" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource BodyFont}"
        TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="Power Plan Switcher settings">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="LogColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- Settings -->
        <Grid Grid.Column="0" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Power Plan Switcher"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" />
                <TextBlock Text="Switch plans from activity and power source."
                           FontSize="13" Margin="0,2,0,0"
                           Foreground="{DynamicResource SecondaryText}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,10,0">
                <StackPanel>

                    <!-- Status -->
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="STATUS" Style="{DynamicResource CardCaption}"
                                           VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="{DynamicResource WindowBackground}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="9" Padding="8,2">
                                    <TextBlock Text="{Binding ModeLabel}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryText}" />
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding StatusLine}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" />
                            <TextBlock Text="{Binding StatusDetail}"
                                       FontSize="12" Margin="0,3,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock Text="{Binding LastCheckedText}"
                                       FontSize="11" Margin="0,4,0,0"
                                       Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock Text="{Binding PauseLabel}"
                                       FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />

                            <Border Background="{DynamicResource ProblemBackground}"
                                    BorderBrush="{DynamicResource ProblemBorder}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="10" Margin="0,10,0,0"
                                    Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Something needs attention"
                                               FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource ProblemText}" />
                                    <TextBlock Text="{Binding Problem}"
                                               TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{DynamicResource ProblemText}"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <Button Content="Show _log" Click="OnShowLog"
                                            HorizontalAlignment="Left" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Pause for 1 _hour" Click="OnPauseHour"
                                        Margin="0,0,8,8"
                                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Pause until _restart" Click="OnPauseRestart"
                                        Margin="0,0,8,8"
                                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}" />
                                <Button Content="_Resume" Click="OnResume"
                                        Margin="0,0,8,8"
                                        Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
                                <Button Content="_Return to automatic" Click="OnReturnToAutomatic"
                                        Style="{DynamicResource AccentButton}" Margin="0,0,8,8"
                                        Visibility="{Binding IsForced, Converter={StaticResource BoolToVis}}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Rules grid -->
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Text="PLAN FOR EACH SITUATION" Style="{DynamicResource CardCaption}" />

                            <Border Background="{DynamicResource NoticeBackground}"
                                    BorderBrush="{DynamicResource NoticeBorder}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="10" Margin="0,0,0,8"
                                    Visibility="{Binding IsForced, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ForcedNotice}" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{DynamicResource NoticeText}" />
                            </Border>

                            <Grid Margin="0,2,0,0" IsEnabled="{Binding IsAutomatic}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition x:Name="BatteryColumn" Width="1.35*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="On AC"
                                           Style="{DynamicResource CardCaption}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="On battery"
                                           x:Name="BatteryHeader"
                                           Style="{DynamicResource CardCaption}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Active"
                                           Style="{DynamicResource BodyText}" Margin="0,4,8,4" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4,4,4"
                                          x:Name="ActiveAcCombo"
                                          ItemsSource="{Binding AvailablePlans}"
                                          SelectedItem="{Binding SelectedActiveAc, Mode=TwoWay}"
                                          SelectionChanged="OnRuleChanged"
                                          AutomationProperties.Name="Active on AC plan" />
                                <ComboBox Grid.Row="1" Grid.Column="2" Margin="0,4,0,4"
                                          x:Name="ActiveBatteryCombo"
                                          ItemsSource="{Binding AvailablePlans}"
                                          SelectedItem="{Binding SelectedActiveBattery, Mode=TwoWay}"
                                          SelectionChanged="OnRuleChanged"
                                          AutomationProperties.Name="Active on battery plan" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Idle"
                                           Style="{DynamicResource BodyText}" Margin="0,4,8,4" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4,4,4"
                                          x:Name="IdleAcCombo"
                                          ItemsSource="{Binding AvailablePlans}"
                                          SelectedItem="{Binding SelectedIdleAc, Mode=TwoWay}"
                                          SelectionChanged="OnRuleChanged"
                                          AutomationProperties.Name="Idle on AC plan" />
                                <ComboBox Grid.Row="2" Grid.Column="2" Margin="0,4,0,4"
                                          x:Name="IdleBatteryCombo"
                                          ItemsSource="{Binding AvailablePlans}"
                                          SelectedItem="{Binding SelectedIdleBattery, Mode=TwoWay}"
                                          SelectionChanged="OnRuleChanged"
                                          AutomationProperties.Name="Idle on battery plan" />
                            </Grid>

                            <TextBlock Text="Only plans that already exist on this PC are listed. The app never changes the plans themselves."
                                       FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryText}" />
                        </StackPanel>
                    </Border>

                    <!-- Idle detection -->
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Text="IDLE DETECTION" Style="{DynamicResource CardCaption}" />

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Consider the PC idle after no input for"
                                           Style="{DynamicResource BodyText}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="56" TextAlignment="Right" VerticalContentAlignment="Center"
                                             Text="{Binding InputTimeoutMinutes, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                             LostFocus="OnTimeoutCommitted"
                                             AutomationProperties.Name="Idle timeout in minutes" />
                                    <TextBlock Text="min" Style="{DynamicResource BodyText}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="1 to 120 minutes. Screensaver and lock can trigger idle sooner."
                                       FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryText}" />

                            <Separator Margin="0,10,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Treat a running screensaver as idle"
                                           Style="{DynamicResource BodyText}" TextWrapping="Wrap" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding OnScreensaver, Mode=TwoWay}"
                                          Click="OnScreensaverOrLockChanged"
                                          AutomationProperties.Name="Treat a running screensaver as idle" />
                            </Grid>

                            <Separator Margin="0,10,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Treat a locked workstation as idle"
                                           Style="{DynamicResource BodyText}" TextWrapping="Wrap" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding OnLock, Mode=TwoWay}"
                                          Click="OnScreensaverOrLockChanged"
                                          AutomationProperties.Name="Treat a locked workstation as idle" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Scanning -->
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Text="SCANNING" Style="{DynamicResource CardCaption}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Check for changes every"
                                           Style="{DynamicResource BodyText}" TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1" MinWidth="170"
                                          ItemsSource="{Binding ScanIntervalChoices}"
                                          SelectedItem="{Binding SelectedScanInterval, Mode=TwoWay}"
                                          SelectionChanged="OnScanIntervalChanged"
                                          AutomationProperties.Name="Scan interval" />
                            </Grid>

                            <TextBlock Text="Shorter intervals notice changes faster. The monitor only applies a plan when the situation changes."
                                       FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryText}" />
                        </StackPanel>
                    </Border>

                    <!-- General -->
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Text="GENERAL" Style="{DynamicResource CardCaption}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Start with Windows"
                                           Style="{DynamicResource BodyText}" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                          Click="OnAutoStartChanged"
                                          AutomationProperties.Name="Start with Windows" />
                            </Grid>

                            <Separator Margin="0,10,0,8" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Version" Style="{DynamicResource BodyText}" />
                                <TextBlock Grid.Column="1" Text="{Binding VersionText}"
                                           Style="{DynamicResource BodyText}" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Settings folder" Style="{DynamicResource BodyText}" />
                                <Button Grid.Column="1" Content="Open" Click="OnOpenConfigFolder" Padding="12,4" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Log folder" Style="{DynamicResource BodyText}" />
                                <Button Grid.Column="1" Content="Open" Click="OnOpenLogFolder" Padding="12,4" />
                            </Grid>

                            <Button Content="Copy _diagnostics" Click="OnCopyDiagnostics"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Recent changes -->
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Text="RECENT CHANGES" Style="{DynamicResource CardCaption}" />
                            <ItemsControl ItemsSource="{Binding RecentChanges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Summary}"
                                                   FontSize="11" Margin="0,0,0,3"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SecondaryText}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Kept in memory for this run."
                                       FontSize="11" Margin="0,6,0,0"
                                       Foreground="{DynamicResource SecondaryText}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,12,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Changes save automatically."
                           Style="{DynamicResource BodyText}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Show _log" Click="OnShowLog" Padding="14,5" />
            </Grid>
        </Grid>

        <GridSplitter x:Name="LogSplitter" Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Visibility="Collapsed"
                      Background="{DynamicResource Border}"
                      ResizeBehavior="PreviousAndNext" />

        <!-- Log pane -->
        <Border x:Name="LogPanel" Grid.Column="2" Visibility="Collapsed"
                Background="{DynamicResource WindowBackground}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="LOG" Style="{DynamicResource CardCaption}"
                               VerticalAlignment="Center" Margin="0" />
                    <Button Content="Close" Click="OnCloseLog"
                            HorizontalAlignment="Right" Padding="12,3" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="LogDateCombo"
                              SelectionChanged="OnLogFileChanged"
                              AutomationProperties.Name="Log date" />
                    <CheckBox Grid.Column="1" x:Name="LogLive" Content="Live"
                              IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center"
                              AutomationProperties.Name="Live log updates" />
                </Grid>

                <TextBox Grid.Row="2" x:Name="LogText"
                         IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas, Courier New"
                         FontSize="12"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         AutomationProperties.Name="Log contents" />

                <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                    <Button Content="Refresh" Click="OnLogRefresh" Margin="0,0,6,6" Padding="10,3" />
                    <Button Content="Open file" Click="OnLogOpenFile" Margin="0,0,6,6" Padding="10,3" />
                    <Button Content="Open folder" Click="OnLogOpenFolder" Margin="0,0,6,6" Padding="10,3" />
                    <Button Content="Copy" Click="OnLogCopy" Padding="10,3" Margin="0,0,0,6" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
