<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette -->
    <Color x:Key="WindowBackgroundColor">#F3F3F5</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="BorderColorValue">#E1E3E8</Color>
    <Color x:Key="TextColorValue">#1B1B1F</Color>
    <Color x:Key="SecondaryTextColorValue">#5C5F66</Color>
    <Color x:Key="AccentColorValue">#0067C0</Color>
    <Color x:Key="AccentHoverColorValue">#115EA3</Color>
    <Color x:Key="ControlColorValue">#B8BCC4</Color>
    <Color x:Key="TrackColorValue">#D3D6DC</Color>
    <Color x:Key="HoverColorValue">#E3E7EE</Color>
    <Color x:Key="PressColorValue">#CFD6E4</Color>
    <Color x:Key="IdleStatusColorValue">#B26A00</Color>
    <Color x:Key="ActiveStatusColorValue">#0F6B2B</Color>

    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBackground" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColorValue}" />
    <SolidColorBrush x:Key="TextBoxBorder" Color="{StaticResource TrackColorValue}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColorValue}" />
    <SolidColorBrush x:Key="SecondaryText" Color="{StaticResource SecondaryTextColorValue}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColorValue}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColorValue}" />
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Control" Color="{StaticResource ControlColorValue}" />
    <SolidColorBrush x:Key="Track" Color="{StaticResource TrackColorValue}" />
    <SolidColorBrush x:Key="ListHover" Color="{StaticResource HoverColorValue}" />
    <SolidColorBrush x:Key="Press" Color="{StaticResource PressColorValue}" />
    <SolidColorBrush x:Key="IdleStatus" Color="{StaticResource IdleStatusColorValue}" />
    <SolidColorBrush x:Key="ActiveStatus" Color="{StaticResource ActiveStatusColorValue}" />
    <SolidColorBrush x:Key="WindowBorder" Color="{StaticResource BorderColorValue}" />

    <SolidColorBrush x:Key="ProblemBackground" Color="#FFF4E5" />
    <SolidColorBrush x:Key="ProblemBorder" Color="#E0B15A" />
    <SolidColorBrush x:Key="ProblemText" Color="#5C3B00" />
    <SolidColorBrush x:Key="NoticeBackground" Color="#EAF2FB" />
    <SolidColorBrush x:Key="NoticeBorder" Color="#A9C8E8" />
    <SolidColorBrush x:Key="NoticeText" Color="#123A5C" />

    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>

</ResourceDictionary>
